generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserProfile {
  admin
  operations
  finance
}

enum WorkStatus {
  planning
  in_progress
  paused
  completed
  cancelled
}

enum ExpenseType {
  material
  labor
  marketing
  documentation
}

enum WorkAccessLevel {
  contributor
  head_moderator
  viewer
  advanced_viewer
}

enum ShareInviteStatus {
  pending
  accepted
  cancelled
}

enum TaskStatus {
  backlog
  todo
  in_progress
  review
  done
}

enum TaskPriority {
  low
  medium
  high
  critical
}

enum RevenueType {
  sale
  rent
  other
}

enum ExpenseStatus {
  pending
  approved
  rejected
}

enum WorkEventType {
  work_created
  work_updated
  status_changed
  expense_created
  expense_approved
  revenue_created
  task_created
  task_moved
  task_done
  attachment_uploaded
}

enum NotificationType {
  task_due
  expense_created
  work_status_changed
}

model User {
  uuid         String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  phone        String
  profile      UserProfile
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  works          Work[]
  expenses       Expense[]
  revenues       Revenue[]
  tasks          Task[]
  attachments    Attachment[]
  workEvents     WorkEvent[]
  notifications  Notification[]
  groupMembers   GroupMember[]
  shareInvites   WorkShareInvite[] @relation("InviteCreator")
  acceptedInvites WorkShareInvite[] @relation("InviteAcceptedBy")
}

model Work {
  uuid           String     @id @default(uuid()) @db.Uuid
  ownerUserUuid  String     @db.Uuid
  name           String
  address        String
  longitude      Float
  latitude       Float
  estimatedPrice Float
  finalBudget    Float      @default(0)
  coverImageUrl  String     @default("")
  status         WorkStatus
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  owner        User              @relation(fields: [ownerUserUuid], references: [uuid], onDelete: Cascade)
  expenses     Expense[]
  revenues     Revenue[]
  tasks        Task[]
  attachments  Attachment[]
  events       WorkEvent[]
  groupWorks   GroupWork[]
  memberAccesses GroupMemberWork[]
  shareInvites WorkShareInvite[]

  @@index([ownerUserUuid])
}

model Expense {
  uuid          String      @id @default(uuid()) @db.Uuid
  ownerUserUuid String      @db.Uuid
  workUuid      String      @db.Uuid
  type          ExpenseType
  status        ExpenseStatus @default(pending)
  name          String
  description   String
  amount        Float
  uploadUrl     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  owner User @relation(fields: [ownerUserUuid], references: [uuid], onDelete: Cascade)
  work  Work @relation(fields: [workUuid], references: [uuid], onDelete: Cascade)

  @@index([ownerUserUuid])
  @@index([workUuid])
}

model Revenue {
  uuid          String      @id @default(uuid()) @db.Uuid
  ownerUserUuid String      @db.Uuid
  workUuid      String      @db.Uuid
  type          RevenueType
  name          String
  description   String      @default("")
  amount        Float
  receivedAt    DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  owner User @relation(fields: [ownerUserUuid], references: [uuid], onDelete: Cascade)
  work  Work @relation(fields: [workUuid], references: [uuid], onDelete: Cascade)

  @@index([ownerUserUuid])
  @@index([workUuid])
  @@index([receivedAt])
}

model Task {
  uuid          String       @id @default(uuid()) @db.Uuid
  ownerUserUuid String       @db.Uuid
  workUuid      String?      @db.Uuid
  title         String
  description   String       @default("")
  assignee      String       @default("")
  dueDate       DateTime?
  status        TaskStatus   @default(todo)
  priority      TaskPriority @default(medium)
  position      Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  owner User  @relation(fields: [ownerUserUuid], references: [uuid], onDelete: Cascade)
  work  Work? @relation(fields: [workUuid], references: [uuid], onDelete: SetNull)

  @@index([ownerUserUuid])
  @@index([workUuid])
  @@index([status, position])
}

model Attachment {
  uuid          String   @id @default(uuid()) @db.Uuid
  ownerUserUuid String   @db.Uuid
  workUuid      String?  @db.Uuid
  filename      String
  originalName  String
  mimeType      String
  size          Int
  storagePath   String
  publicUrl     String
  createdAt     DateTime @default(now())

  owner User  @relation(fields: [ownerUserUuid], references: [uuid], onDelete: Cascade)
  work  Work? @relation(fields: [workUuid], references: [uuid], onDelete: SetNull)

  @@index([ownerUserUuid])
  @@index([workUuid])
}

model WorkEvent {
  uuid          String        @id @default(uuid()) @db.Uuid
  ownerUserUuid String        @db.Uuid
  workUuid      String        @db.Uuid
  type          WorkEventType
  title         String
  description   String        @default("")
  metadata      Json?
  createdAt     DateTime      @default(now())

  owner User @relation(fields: [ownerUserUuid], references: [uuid], onDelete: Cascade)
  work  Work @relation(fields: [workUuid], references: [uuid], onDelete: Cascade)

  @@index([ownerUserUuid])
  @@index([workUuid])
  @@index([createdAt])
}

model Notification {
  uuid          String           @id @default(uuid()) @db.Uuid
  ownerUserUuid String           @db.Uuid
  workUuid      String?          @db.Uuid
  type          NotificationType
  title         String
  description   String           @default("")
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  owner User @relation(fields: [ownerUserUuid], references: [uuid], onDelete: Cascade)

  @@index([ownerUserUuid])
  @@index([workUuid])
  @@index([readAt])
}

model Group {
  uuid          String   @id @default(uuid()) @db.Uuid
  ownerUserUuid String   @db.Uuid
  name          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members      GroupMember[]
  works        GroupWork[]
  shareInvites WorkShareInvite[]

  @@index([ownerUserUuid])
}

model GroupMember {
  uuid        String          @id @default(uuid()) @db.Uuid
  groupUuid   String          @db.Uuid
  userUuid    String          @db.Uuid
  accessLevel WorkAccessLevel
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  group Group @relation(fields: [groupUuid], references: [uuid], onDelete: Cascade)
  user  User  @relation(fields: [userUuid], references: [uuid], onDelete: Cascade)
  workAccesses GroupMemberWork[]

  @@unique([groupUuid, userUuid])
  @@index([userUuid])
}

model GroupMemberWork {
  uuid      String   @id @default(uuid()) @db.Uuid
  memberUuid String  @db.Uuid
  workUuid   String  @db.Uuid
  createdAt DateTime @default(now())

  member GroupMember @relation(fields: [memberUuid], references: [uuid], onDelete: Cascade)
  work   Work        @relation(fields: [workUuid], references: [uuid], onDelete: Cascade)

  @@unique([memberUuid, workUuid])
  @@index([workUuid])
}

model GroupWork {
  uuid      String   @id @default(uuid()) @db.Uuid
  groupUuid String   @db.Uuid
  workUuid  String   @db.Uuid
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupUuid], references: [uuid], onDelete: Cascade)
  work  Work  @relation(fields: [workUuid], references: [uuid], onDelete: Cascade)

  @@unique([groupUuid, workUuid])
  @@index([workUuid])
}

model WorkShareInvite {
  uuid           String            @id @default(uuid()) @db.Uuid
  token          String            @unique
  groupUuid      String            @db.Uuid
  workUuid       String            @db.Uuid
  createdByUuid  String            @db.Uuid
  acceptedByUuid String?           @db.Uuid
  accessLevel    WorkAccessLevel
  status         ShareInviteStatus @default(pending)
  acceptedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  group      Group @relation(fields: [groupUuid], references: [uuid], onDelete: Cascade)
  work       Work  @relation(fields: [workUuid], references: [uuid], onDelete: Cascade)
  createdBy  User  @relation("InviteCreator", fields: [createdByUuid], references: [uuid], onDelete: Cascade)
  acceptedBy User? @relation("InviteAcceptedBy", fields: [acceptedByUuid], references: [uuid], onDelete: SetNull)

  @@index([groupUuid])
  @@index([workUuid])
  @@index([createdByUuid])
}
